NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Generate distinct, random secrets. Requests fail closed if absent.
DEVICE_WEBHOOK_SECRET=
CRON_SECRET=

# App -> local backend -> raw Baileys/pyzk bridge, all on the same PC.
LOCAL_BACKEND_URL=http://127.0.0.1:14310
LOCAL_BRIDGE_URL=http://127.0.0.1:14320
LOCAL_HARDWARE_BRIDGE_URL=http://127.0.0.1:14318
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
LOCAL_BACKEND_TOKEN=
LOCAL_BRIDGE_TOKEN=
# Optional override: directory containing installed WhatsApp service.mjs/store.mjs/boundary.mjs.
BRIDGE_WHATSAPP_SOURCE=
INSTITUTE_ALLOWED_ORIGINS=*
# Optional path to the installed or portable OkashaBridge.exe launcher.
BRIDGE_EXE=
BRIDGE_PYTHON=.venv-bridge/Scripts/python.exe
# Leave K40 empty until the device is available. Pair WhatsApp from Settings.
BRIDGE_K40_DEVICE_ID=
K40_IP=
K40_PORT=4370
K40_COMM_KEY=0
K40_FORCE_UDP=false
# Optional account pin; otherwise use the account paired with this institute instance.
BRIDGE_WHATSAPP_ACCOUNT_ID=

# Optional SMS, configured server-side only. WhatsApp uses Baileys via the bridge.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Run node scripts/generate-vapid.js once to generate private keys locally.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:mrzeeshan6009@gmail.com
